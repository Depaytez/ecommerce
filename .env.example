# =============================================
# JRADIANCE E-Commerce Environment Variables
# =============================================
# Copy this file to .env.local and fill in your values
# DO NOT commit real secrets or credentials to version control!

# SUPABASE CONFIGURATION
# Get from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key - KEEP SECRET! Only used in server actions and webhook handlers
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# STRIPE PAYMENT GATEWAY
# Get from: https://dashboard.stripe.com/apikeys
# Publishable key used in client-side Stripe Elements
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Secret key used strictly on server-side
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
# Stripe Webhook Signing Secret (from Stripe CLI or Dashboard Webhook settings)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# PAYSTACK PAYMENT GATEWAY (Dual-Gateway Architecture)
# Get from: https://dashboard.paystack.com/#/settings/developer
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
PAYSTACK_WEBHOOK_SECRET=whsec_your_paystack_webhook_secret

# APPLICATION BASE URLs
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ENVIRONMENT
NODE_ENV=development